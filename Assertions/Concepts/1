🧠 10. Example — Self-Contained Simulation Demo
systemverilog
Copy code
module tb_immediate_assertion;
  logic clk = 0, write = 0, read = 0, reset = 0, data_ready = 1;
  logic [7:0] addr = 8'h00;

  always #5 clk = ~clk;

  always @(posedge clk) begin
    assert (!(write && read))
      else $error("Write & Read active together!");

    assert (addr < 8'hF0)
      else $fatal("Invalid address: %h", addr);
  end

  initial begin
    repeat (2) @(posedge clk);
    write = 1; read = 1; // This will fail
    addr  = 8'hF5;       // Also fails
    #20 $finish;
  end
endmodule
